+        return "  ".join(value.ljust(widths[i]) for i, value in enumerate(row)).rstrip()
+
+    text = render(headers) + "\n"
+    text += render(["-" * width for width in widths]) + "\n"
+    for row in rows:
+        text += render(row) + "\n"
+    return text.rstrip()
